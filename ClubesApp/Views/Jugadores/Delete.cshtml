@model ClubesApp.Models.Jugador

@{
    ViewData["Title"] = "Eliminar jugador";
}

<h1>Eliminar jugador</h1>
<h3>¿Seguro que deseas eliminar este jugador?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Posicion)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Posicion)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Dorsal)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Dorsal)</dd>

    <dt class="col-sm-2">Club</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Club!.Nombre)</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar" class="btn btn-danger" /> |
    <a asp-action="Index">Volver a la lista</a>
</form>

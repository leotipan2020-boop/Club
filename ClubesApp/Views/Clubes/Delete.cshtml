@model ClubesApp.Models.Club

@{
    ViewData["Title"] = "Eliminar club";
}

<h1>Eliminar club</h1>
<h3>¿Seguro que deseas eliminar este club?</h3>
<p class="text-danger">Ojo: también se eliminarán los jugadores de este club.</p>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ciudad)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Ciudad)</dd>
</dl>
<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar" class="btn btn-danger" /> |
    <a asp-action="Index">Volver a la lista</a>
</form>
